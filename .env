# ⚠️ IMPORTANT: Never commit this file to GitHub!
# Add .env to .gitignore immediately!

# ============ DATABASE ============
# Use environment-specific connection strings
# For production: Use a service like Heroku, Atlas, etc.
MONGO_URI=your_secure_mongodb_uri_here

# ============ SERVER ============
PORT=5000
NODE_ENV=development

# ============ JWT ============
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_strong_random_secret_key_here_at_least_32_chars
JWT_REFRESH_SECRET=your_strong_refresh_secret_key_here_at_least_32_chars

# ============ EMAIL ============
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=KNHS Portal <noreply@youromain.com>

# ============ SECURITY ============
# Set to your frontend domain in production
CORS_ORIGIN=http://localhost:3000
SESSION_SECRET=your_session_secret_here

# ============ RATE LIMITING ============
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100
